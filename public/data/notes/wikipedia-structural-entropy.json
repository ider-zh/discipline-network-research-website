0.8991, 0.8929, 0.8882, 0.8875, 0.8869, 0.887, 0.8872, 0.8864, 0.8874, 0.8854, 0.87, 0.8685, 0.87, 0.8705, 0.8709, 0.8701, 0.8705, 0.8707, 0.8706, 0.8712, 0.8718, 0.8709, 0.8709, 0.8705, 0.8707, 0.8708, 0.8702, 0.8694, 0.8674, 0.8656, 0.8648, 0.8656, 0.8666, 0.868, 0.8697, 0.8709, 0.8718, 0.8725, 0.8731, 0.8739, 0.8748, 0.8757, 0.8764, 0.8768, 0.8774, 0.878, 0.8787, 0.8794, 0.88, 0.8805, 0.8816, 0.8824, 0.8826, 0.8831, 0.8826, 0.8828, 0.8834, 0.8839, 0.8841, 0.8834, 0.8837, 0.8842, 0.8847, 0.8853, 0.886, 0.8867, 0.8875, 0.8883, 0.8891, 0.8893, 0.8896, 0.8898, 0.8902, 0.8906, 0.8908, 0.8911, 0.8915, 0.892, 0.8922, 0.8926, 0.893, 0.8931, 0.8935, 0.8939, 0.8943, 0.8947, 0.895, 0.8954, 0.8957, 0.8961, 0.8965, 0.8967, 0.8971, 0.8973, 0.8975, 0.8977, 0.898, 0.8982, 0.8984, 0.8986, 0.8987, 0.8988, 0.8989, 0.8989, 0.899, 0.8991, 0.8991, 0.8991, 0.899, 0.8988, 0.8986, 0.8984, 0.8982, 0.898, 0.8979, 0.898, 0.8982, 0.8984, 0.8985, 0.8987]\n        },\n        {\n            \"name\": \"linksin\",\n            \"type\": \"line\",\n            \"smooth\": false,\n            \"data\": [0.9428, 0.9414, 0.9407, 0.94, 0.9391, 0.9382, 0.9377, 0.9371, 0.9362, 0.9356, 0.9354, 0.9355, 0.9349, 0.9343, 0.9338, 0.9336, 0.9335, 0.9334, 0.9331, 0.933, 0.9326, 0.932, 0.9315, 0.9306, 0.93, 0.9291, 0.9277, 0.9267, 0.9256, 0.9241, 0.9229, 0.9218, 0.921, 0.92, 0.9196, 0.919, 0.9184, 0.9177, 0.9173, 0.9168, 0.9163, 0.916, 0.9156, 0.9155, 0.9153, 0.9153, 0.9152, 0.9151, 0.9149, 0.9144, 0.9138, 0.9131, 0.9123, 0.9115, 0.9107, 0.9097, 0.9087, 0.9075, 0.9064, 0.9051, 0.9038, 0.9024, 0.9011, 0.8999, 0.8984, 0.8967, 0.895, 0.8935, 0.8919, 0.8904, 0.8887, 0.8871, 0.8855, 0.8841, 0.8828, 0.8817, 0.8805, 0.8795, 0.8786, 0.8776, 0.8766, 0.8757, 0.875, 0.8742, 0.8736, 0.8729, 0.8722, 0.8715, 0.8709, 0.8701, 0.8695, 0.8689, 0.8682, 0.8676, 0.8671, 0.8665, 0.866, 0.8654, 0.8648, 0.8642, 0.8636, 0.8631, 0.8626, 0.8621, 0.8615, 0.8608, 0.86, 0.8592, 0.8582, 0.857, 0.8558, 0.8544, 0.8529, 0.8512, 0.8496, 0.8482, 0.847, 0.846, 0.8452, 0.8443, 0.8441]\n        },\n        {\n            \"name\": \"linksout\",\n            \"type\": \"line\",\n            \"smooth\": false,\n            \"data\": [0.88, 0.8813, 0.8692, 0.86, 0.8594, 0.8592, 0.8598, 0.8611, 0.8601, 0.8632, 0.8595, 0.8259, 0.8236, 0.8279, 0.8297, 0.8311, 0.8299, 0.831, 0.8321, 0.8322, 0.8339, 0.8361, 0.8349, 0.8356, 0.835, 0.8363, 0.8378, 0.8376, 0.8367, 0.8336, 0.8306, 0.8295, 0.8317, 0.8343, 0.8372, 0.8407, 0.8433, 0.8457, 0.8472, 0.8486, 0.8505, 0.8525, 0.8545, 0.8559, 0.8568, 0.858, 0.859, 0.8605, 0.8619, 0.863, 0.8641, 0.8667, 0.8683, 0.8689, 0.8701, 0.8693, 0.8702, 0.8717, 0.8732, 0.8741, 0.8732, 0.8744, 0.8759, 0.8771, 0.879, 0.8813, 0.8833, 0.8858, 0.8883, 0.8907, 0.8922, 0.8939, 0.8954, 0.8972, 0.8987, 0.9, 0.9012, 0.9027, 0.9043, 0.9054, 0.9067, 0.908, 0.9086, 0.9098, 0.9109, 0.912, 0.9133, 0.9144, 0.9156, 0.9167, 0.9178, 0.9189, 0.9197, 0.9207, 0.9216, 0.9222, 0.9228, 0.9237, 0.9245, 0.9252, 0.9258, 0.9265, 0.9269, 0.9274, 0.928, 0.9286, 0.9292, 0.9298, 0.9304, 0.9312, 0.9316, 0.9322, 0.9328, 0.9336, 0.9344, 0.9353, 0.9362, 0.9372, 0.9381, 0.9391, 0.9397]\n        }\n    ]\n}\n```\n\n### 计算程序\n```python\n\ndef handle(full_linsin_dict: dict, subject_id_set: set):\n    '''\n    full_linsin_dict: 所有 节点 的 linksin\n        dict{\n            id_1 : [linsin_id_1, linsin_id_2 ...]\n            ...\n        }\n    subject_id_set: 当前学科的 id set\n        set([id_1,id_2 ...])\n        \n    return retin,retout,retall 返回 ；linksin,linksout, all_edge 计算出的结构熵\n    '''\n    # 获取当前学科所有内部的边 （linksin, linksout），存储到  subject_dict\n    subject_dict = {}\n    for item in subject_id_set:\n        if item in full_linsin_dict:\n            for linksin_id in full_linsin_dict[item]:\n                if linksin_id in subject_id_set:\n                    subject_dict.setdefault(linksin_id,{\"in\":set(),\"out\":set()})\n                    subject_dict.setdefault(item,{\"in\":set(),\"out\":set()})\n                    subject_dict[item][\"in\"].add(linksin_id)\n                    subject_dict[linksin_id][\"out\"].add(item)\n    print(\"subject_dict\",len(subject_dict))\n    \n    \n    #  计算 熵\n    # insum : linksin 的所有度数， iN: 包含 linksin 的节点数\n    insum = 0\n    iN = 0\n    \n    # outsum : linksout 的所有度数， oN: 包含 linksout 的节点数\n    outsum = 0\n    oN = 0\n    \n    # allsum : 所有度数， allN: 包含 边 的节点数\n    allsum = 0\n    allN = 0\n    \n    for data in subject_dict.values():\n        cache = len(data[\"in\"])\n        if cache:\n            iN += 1\n            insum += cache\n            \n        cache = len(data[\"out\"])\n        if cache:\n            oN += 1\n            outsum += cache\n        \n        # set 的并集，去重\n        cache = len(data['in'] | data['out'])\n        if cache:\n            allN += 1\n            allsum += cache\n    \n    # 没有 linksin 的网络不存在边，直接返回\n    if not iN or not oN:\n        return None,None,None\n    \n    # E min\n    i_E_min = math.log(4 * (iN-1))\n    o_E_min = math.log(4 * (oN-1))\n    all_E_min = math.log(4 * (allN-1))\n    \n    # 计算 E\n    iI = 0\n    oI = 0\n    allI = 0\n    for data in subject_dict.values():\n        cache = len(data[\"in\"])\n        if cache:\n            I = cache / insum\n            iI += I * math.log(I)\n            \n        cache = len(data[\"out\"])\n        if cache:\n            I = cache / outsum\n            oI += I * math.log(I)\n            \n        cache = len(data['in'] | data['out'])\n        if cache:\n            I = cache / allsum\n            allI += I * math.log(I)\n\n    \n    retin = (-2 * iI - i_E_min) / (2 * math.log(iN) - i_E_min)\n    retout = (-2 * oI - o_E_min) / (2 * math.log(oN) - o_E_min)\n    retall = (-2 * allI - all_E_min) / (2 * math.log(allN) - all_E_min)\n\n    return retin,retout,retall\n```"}
